# Environment variables for URL Ingestion Pipeline

# Cohere API key - get from https://cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant Cloud URL - get from your Qdrant cloud dashboard
QDRANT_URL=your_qdrant_cloud_url_here

# Qdrant Cloud API key
QDRANT_API_KEY=your_qdrant_api_key_here

# Base URL to start ingestion from (optional, defaults to https://example.com)
BASE_URL=https://example.com