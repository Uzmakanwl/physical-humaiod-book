{
  "name": "ai-driven-book",
  "version": "1.0.0",
  "description": "AI-Driven Book - A RAG system with embedding pipeline for processing Docusaurus documentation sites",
  "main": "index.js",
  "scripts": {
    "start": "cd frontend-book/frontend-book && npm start",
    "build": "cd frontend-book/frontend-book && npm run build",
